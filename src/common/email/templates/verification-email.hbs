<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Verify Your Email</title>
</head>
<body style="margin: 0; padding: 0; background-color: #f3f4f6; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;">
    <!-- Wrapper -->
    <table width="100%" cellpadding="0" cellspacing="0" style="background-color: #f3f4f6;">
        <tr>
            <td align="center" style="padding: 40px 20px;">
                <!-- Main container -->
                <table width="100%" max-width="600" cellpadding="0" cellspacing="0" style="background-color: #ffffff; border-radius: 12px; box-shadow: 0 4px 6px rgba(0, 0, 0, 0.07); overflow: hidden;">

                    <!-- Header section with gradient -->
                    <tr>
                        <td style="background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%); padding: 40px 20px; text-align: center;">
                            <!-- Lock icon -->
                            <div style="font-size: 48px; margin-bottom: 16px; line-height: 1;">🔐</div>
                            <h1 style="color: #ffffff; font-size: 28px; font-weight: 600; margin: 0; letter-spacing: -0.5px;">Verify Your Email</h1>
                            <p style="color: rgba(255, 255, 255, 0.9); font-size: 15px; margin: 8px 0 0 0; line-height: 1.5;">Complete your account setup</p>
                        </td>
                    </tr>

                    <!-- Content section -->
                    <tr>
                        <td style="padding: 40px 32px;">
                            <!-- Greeting -->
                            <p style="color: #1f2937; font-size: 15px; line-height: 1.6; margin: 0 0 24px 0;">
                                Hello,
                            </p>

                            <!-- Main message -->
                            <p style="color: #374151; font-size: 15px; line-height: 1.6; margin: 0 0 28px 0;">
                                Thanks for signing up! To complete your account verification, please click the button below. This link will expire in 24 hours.
                            </p>

                            <!-- CTA Button -->
                            <table width="100%" cellpadding="0" cellspacing="0" style="margin: 32px 0;">
                                <tr>
                                    <td align="center">
                                        <table cellpadding="0" cellspacing="0">
                                            <tr>
                                                <td style="background-color: #2563eb; border-radius: 8px; text-align: center;">
                                                    <a href="{{verificationUrl}}" style="display: inline-block; padding: 14px 40px; color: #ffffff; text-decoration: none; font-size: 15px; font-weight: 600; letter-spacing: 0.3px; transition: background-color 0.2s ease;">Verify Email Address</a>
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            </table>

                            <!-- Divider -->
                            <div style="height: 1px; background-color: #e5e7eb; margin: 32px 0;"></div>

                            <!-- Fallback link -->
                            <p style="color: #6b7280; font-size: 13px; line-height: 1.6; margin: 0 0 20px 0;">
                                If the button doesn't work, copy and paste this link in your browser:
                            </p>
                            <p style="color: #2563eb; font-size: 13px; line-height: 1.6; margin: 0 0 28px 0; word-break: break-all;">
                                <a href="{{verificationUrl}}" style="color: #2563eb; text-decoration: underline;">{{verificationUrl}}</a>
                            </p>

                            <!-- Security note -->
                            <table width="100%" cellpadding="16" cellspacing="0" style="background-color: #f0f9ff; border-left: 4px solid #0ea5e9; border-radius: 6px; margin: 24px 0;">
                                <tr>
                                    <td>
                                        <p style="color: #0369a1; font-size: 13px; line-height: 1.5; margin: 0; font-weight: 500;">
                                            🔒 Security Note: Never share this link with anyone. We'll never ask for your password via email.
                                        </p>
                                    </td>
                                </tr>
                            </table>

                            <!-- Help text -->
                            <p style="color: #6b7280; font-size: 13px; line-height: 1.6; margin: 28px 0 0 0;">
                                If you didn't create this account, please ignore this email. Your email address will not be verified.
                            </p>
                        </td>
                    </tr>

                    <!-- Footer section -->
                    <tr>
                        <td style="background-color: #f9fafb; padding: 24px 32px; border-top: 1px solid #e5e7eb;">
                            <p style="color: #9ca3af; font-size: 12px; line-height: 1.5; margin: 0 0 12px 0; text-align: center;">
                                This email was sent to <strong style="color: #6b7280;">{{userEmail}}</strong>
                            </p>
                            <p style="color: #d1d5db; font-size: 11px; line-height: 1.4; margin: 0; text-align: center;">
                                © 2026 Your Company. All rights reserved.
                            </p>
                        </td>
                    </tr>

                </table>
                <!-- End main container -->
            </td>
        </tr>
    </table>
</body>
</html>
