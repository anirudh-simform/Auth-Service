// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client-js"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String          @id @default(uuid(7)) @db.Uuid
  email             String          @unique
  password_hash     String?
  is_email_verified Boolean         @default(false)
  terms_accepted_at DateTime?       @db.Timestamptz(6)
  created_at        DateTime        @default(now()) @db.Timestamptz(6)
  updated_at        DateTime        @updatedAt @db.Timestamptz(6)
  magic_links       MagicLink[]
  userSessions      UserSession[]
  orgMemberships    OrgMembership[]
  oauthAccounts     OAuthAccount[]
}

// Links a social-login identity (Google/GitHub/Microsoft) to a User. A user
// created purely via OAuth has no password_hash - this is their only credential.
model OAuthAccount {
  id                  String   @id @default(uuid(7)) @db.Uuid
  provider            String
  provider_account_id String
  user_id             String   @db.Uuid
  user                User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  created_at          DateTime @default(now()) @db.Timestamptz(6)

  @@unique([provider, provider_account_id])
  @@index([user_id])
}

enum MagicLinkType {
  USER_REGISTRATION
  USER_AUTHENTICATION
}

model MagicLink {
  id              String        @id @default(uuid(7)) @db.Uuid
  user_id         String        @db.Uuid
  user            User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  token_hash      String        @unique
  expires_at      DateTime      @db.Timestamptz(6)
  magic_link_type MagicLinkType
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  updated_at      DateTime      @updatedAt @db.Timestamptz(6)
}

model UserSession {
  id                 String    @id @db.Uuid
  user_id            String    @db.Uuid
  user               User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  refresh_token_hash String
  ip_address         String    @db.Inet
  user_agent         String    @default("Unknown")
  last_active_at     DateTime  @db.Timestamptz(6)
  expires_at         DateTime  @db.Timestamptz(6)
  revoked_at         DateTime? @db.Timestamptz(6)
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  updated_at         DateTime  @updatedAt @db.Timestamptz(6)

  @@index([user_id])
  @@index([expires_at])
}

model Permission {
  id                 String              @id @default(uuid(7)) @db.Uuid
  key                String              @unique
  name               String
  created_at         DateTime            @default(now()) @db.Timestamptz(6)
  orgRolePermissions OrgRolePermission[]
}

model Organization {
  id             String          @id @default(uuid(7)) @db.Uuid
  name           String
  orgRoles       OrgRole[]
  orgMemberships OrgMembership[]
}

model OrgRolePermission {
  id            String     @id @default(uuid(7)) @db.Uuid
  role_id       String     @db.Uuid
  role          OrgRole    @relation(fields: [role_id], references: [id])
  permission_id String     @db.Uuid
  permissions   Permission @relation(fields: [permission_id], references: [id])
}

model OrgRole {
  id                 String              @id @default(uuid(7)) @db.Uuid
  org_id             String              @db.Uuid
  org                Organization        @relation(fields: [org_id], references: [id])
  role_name          String
  is_system          Boolean             @default(false)
  parent_role_id     String?             @db.Uuid
  parentRole         OrgRole?            @relation("RoleHierarchy", fields: [parent_role_id], references: [id])
  childRoles         OrgRole[]           @relation("RoleHierarchy")
  orgMemberships     OrgMembership[]
  orgRolePermissions OrgRolePermission[]

  @@unique([org_id, role_name])
}

model OrgMembership {
  id         String       @id @default(uuid(7)) @db.Uuid
  org_id     String       @db.Uuid
  org        Organization @relation(fields: [org_id], references: [id])
  user       User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id    String       @db.Uuid
  orgRole    OrgRole      @relation(fields: [orgRole_id], references: [id])
  orgRole_id String       @db.Uuid

  @@unique([user_id, orgRole_id])
  @@unique([user_id, org_id])
}

// Deliberately has no foreign keys - audit rows must survive deletion of the
// entities they reference. `sequence` (not created_at) is the authoritative
// hash-chain order, since timestamps can collide under concurrent writes.
model AuditLog {
  id            String   @id @default(uuid(7)) @db.Uuid
  sequence      BigInt   @unique @default(autoincrement())
  event_type    String
  actor_user_id String?  @db.Uuid
  org_id        String?  @db.Uuid
  target_type   String?
  target_id     String?
  metadata      Json?
  ip_address    String?  @db.Inet
  user_agent    String?
  prev_hash     String
  entry_hash    String   @unique
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  @@index([org_id])
  @@index([actor_user_id])
  @@index([sequence])
}
